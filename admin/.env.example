# ROOFY Admin — secrets (copy to admin/.env, which is gitignored).
# On the VPS, prefer setting these in the systemd unit's Environment= instead.
# Leave any of these blank/unset and the related feature stays INERT (no errors).

# ── Auto news pipeline ─────────────────────────────────────────────
# News source API. provider = gnews (default) | newsapi. Get a key from
# gnews.io or newsapi.org (free tiers are dev-only; paid for production display).
NEWS_API_PROVIDER=gnews
NEWS_API_KEY=

# Claude API key for the bilingual summariser (shared with the planned AI chat).
ANTHROPIC_API_KEY=
# Override to use a relay/gateway instead of Anthropic direct (e.g. a new-api
# proxy exposing the Anthropic /v1/messages API). Leave unset for Anthropic direct.
# ANTHROPIC_BASE_URL=https://www.apiporter.com
# Auth header: x-api-key (Anthropic direct) or bearer (most relays). Auto-picked
# by host; set explicitly only if your gateway differs.
# ANTHROPIC_AUTH_STYLE=bearer
# Model for summaries. Default claude-opus-4-8; claude-sonnet-4-6 / claude-haiku-4-5
# for lower cost. Must be a model the key/gateway exposes.
NEWS_SUMMARY_MODEL=claude-opus-4-8
