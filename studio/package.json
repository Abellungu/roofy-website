        "lucide-react": "^0.460.0",
        "nanoid": "^5.0.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-is": "^18.3.1",
        "react-window": "^1.8.10",
        "sanity": "^3.74.0",
        "styled-components": "^6.1.13"
