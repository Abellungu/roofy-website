# Copy to .env.local (gitignored) once Sanity project is created
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Editor-scoped API token for migration scripts (Sanity dashboard > API > Tokens > Editor).
# Read by migrate/from-json.ts and migrate/pull-i18n.ts.
SANITY_AUTH_TOKEN=

# Frontend preview-mode read token (Viewer-scoped) — used by site/assets/js/roofy-data.js
# when /?preview=1 is in the URL. Exposed to the browser, so MUST be read-only.
SANITY_STUDIO_PREVIEW_TOKEN=
